---
// src/components/ProductoCard.astro
interface Props {
  title: string;
  price: number;
  category: string;
  rating: number;
  thumbnail: string;
}

const { title, price, category, rating, thumbnail } = Astro.props;
---

<article class="producto" data-title={title.toLowerCase()}>
  <div class="img-container">
    <img src={thumbnail} alt={`Imagen de ${title}`} loading="lazy" />
  </div>
  <div class="info">
    <span class="badge">{category}</span>
    <h2>{title}</h2>
    <div class="footer-info">
      <p class="price">${price.toFixed(2)}</p>
      <p class="rating">⭐ {rating}</p>
    </div>
  </div>
</article>

<style>
  .producto {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .producto:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }

  .img-container {
    width: 100%;
    height: 180px;
    background-color: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .info {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .badge {
    align-self: flex-start;
    font-size: 0.75rem;
    text-transform: uppercase;
    background-color: #eff6ff;
    color: #2563eb;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  h2 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    flex-grow: 1;
  }

  .footer-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-color);
    padding-top: 0.75rem;
  }

  .price {
    font-weight: 700;
    font-size: 1.2rem;
    color: #0f172a;
  }

  .rating {
    font-size: 0.9rem;
    color: #d97706;
  }
</style>